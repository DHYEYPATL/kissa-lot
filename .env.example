# Required for live Gemini calls (Google AI Studio or Vertex).
# Accepted packages: google-genai / google-adk / google-cloud-aiplatform
GEMINI_API_KEY=
# Optional Vertex / Agent Engine path
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=false
GEMINI_MODEL=gemini-2.5-flash

# Required for live Parallel Search API (https://platform.parallel.ai)
PARALLEL_API_KEY=
PARALLEL_SEARCH_MODE=fast

# App
KISSA_HOST=0.0.0.0
KISSA_PORT=8080
KISSA_DEMO_MODE=false
